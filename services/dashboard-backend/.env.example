# The URL of the Go control plane (no trailing slash).
CONTROL_URL=http://localhost:8080

# Bearer token used to authenticate with the control plane.
CONTROL_API_TOKEN=local-development-token

# Address this server binds to.
HOST=0.0.0.0

# Port this server listens on.
PORT=3001

# Origin allowed for CORS (default: http://localhost:5173).
CORS_ORIGINS=http://localhost:5173

# Seconds between dashboard snapshots sent to each SSE client.
DASHBOARD_POLL_INTERVAL=5

# Maximum number of simultaneous SSE clients.
MAX_SSE_CONNECTIONS=10
